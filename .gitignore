# fetched OMB Historical Tables + enabling public laws; the committed file IS the audit trail)
!/data/federal-comparability.json
# …and the CA parity enrichment source-of-record (Phase 61: inline-authored,
# git-reviewed concept library + router + expanded audit trail; $0, no paid API)
!/data/caParityEnrichment61.mjs
!/data/caParityEnrichment61_oprev.mjs
!/data/ca-parity-enrichment-61.expanded.json
# …and the EV fundraising goal (Phase 76: manual, public donor-facing figure —
# committed/reviewable, deliberately outside the gitignored data/ev-sources/ exports)
!/data/ev-goal.json
# …and the VA town→county relationship map (Phase 81: inline-authored from U.S. Census
# 2020 Geographic Relationship Files; the committed file IS the sourcing audit trail)
!/data/vaTownCounties.json
# …and the VA parity enrichment source-of-record (Phase 82: inline-authored,
# git-reviewed explicit concept map + expanded audit trail; $0, no paid API)
!/data/vaEnrichment82.mjs
!/data/va-enrichment-82.expanded.json
# …and the Ohio parity enrichment source-of-record (Phase 87: inline-authored,
# git-reviewed explicit concept map + expanded audit trail; $0, no paid API)
!/data/ohioEnrichment87.mjs
!/data/ohio-enrichment-87.expanded.json
# …and the MN parity enrichment source-of-record (Phase 92: inline-authored,
# git-reviewed explicit last-segment concept map + expanded audit trail; $0, no paid API)
!/data/mnEnrichment92.mjs
!/data/mn-enrichment-92.expanded.json
# …and the Tucson parity enrichment source-of-record (Phase 129 Plan 03: inline-authored,
# git-reviewed mixed universal + Tucson-scoped concept map + expanded audit trail; $0, no paid API)
!/data/tucsonEnrichment129.mjs
!/data/tucson-enrichment-129.expanded.json
# …and the Seattle + King County enrichment source-of-record (Task 12, Seattle/King County
# onboarding: inline-authored, git-reviewed, both entities fully municipality-scoped; $0, no paid API)
