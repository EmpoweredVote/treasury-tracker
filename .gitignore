# Supabase temp files
supabase/.temp/

# Static data files — all data served from Supabase via API
public/data/
src/data/processedBudget.json
/data/*
# …except the federal enrichment source-of-record (Phase 46: inline-authored,
# git-reviewed explainer text — the committed file IS the audit trail)
!/data/federal-enrichment.json
# …and the federal program-origins identifier list (Phase 47: identifiers only,
# all fact values fetched from Congress.gov/GovInfo at load time)
!/data/federal-programs.json
# …and the comparability / definition-drift notes (Phase 51: inline-authored from
# fetched OMB Historical Tables + enabling public laws; the committed file IS the audit trail)
!/data/federal-comparability.json
# …and the verbatim GAO function-definition snapshot it was authored from
!docs/federal/
docs/federal/*
!docs/federal/gao_appendix4.txt

# PDF render cache — PNG files rendered from ACFRs (can be large, regenerated on demand)
cache/

# MA DLS scraper output — large JSON files and progress ledger
scripts/output/

