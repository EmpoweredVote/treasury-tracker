.env
.env.*
!.env.example

# Planning recon data samples (large source xlsx/csv kept locally, not tracked)
.planning/**/samples/

# Temporary ACFR PDFs for reconciliation (not committed)
_acfr-tmp/

# Recon sample downloads (e.g. VA APA comparative-report XLSX) — not committed
_va-recon/

# Ohio AOS recon sample downloads — not committed
_oh-recon/

# Transient loader driver output (scratch; logs already ignored)
scripts/*.failures.txt

# EV donation/bank source exports — contain donor PII; never commit (Phase 74/75)
data/ev-sources/

# Local UAT / debug screenshots — throwaway captures, not version-controlled
screenshots/

# Python bytecode cache
**/__pycache__/

# Minnesota OSA recon sample downloads — not committed
_mn-recon/

# State ACFR recon working copies (downloaded PDFs + extracted text) — local re-derivation only,
# never committed; the app links the official public source_url for every figure (Phase 98/103).
_acfr-work/

# MN load failure logs (runtime, not tracked)
scripts/load-mn-*.failures.txt

# State-GF source-document PDFs kept in the repo root as local recon working copies
# (e.g. state-2023-acfr.pdf = State of MN FY2023 ACFR; 2025_NASBO_State_Expenditure_Report_S.pdf).
# The app links to the official PUBLIC source_url for every figure — never these local files;
# these are offline re-derivation copies only (large binaries, not version-controlled).
/*.pdf
