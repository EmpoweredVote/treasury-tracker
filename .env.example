# Copy this file to .env and fill in real values as needed.

# Origin serving Essentials' public coverage.json (confirm canonical origin at Essentials deploy)
VITE_ESSENTIALS_URL=https://essentials.empowered.vote

# API the dev server's /api proxy forwards to. Unset = the live public API
# (https://accounts-api.empowered.vote): real data, no keys needed.
# Running ev-accounts locally? Point it there instead:
# VITE_API_URL=http://localhost:5050
