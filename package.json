{
  "name": "treasury-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:acfr": "py -3 scripts/lib/acfrGF.selftest.py",
    "smoke:essentials": "node scripts/essentials-live-smoke.mjs",
    "process-budget": "node scripts/processBudget.js",
    "process-revenue": "node scripts/processRevenue.js",
    "process-salaries": "node scripts/processSalaries.js",
    "process-transactions": "node scripts/processTransactions.js",
    "process-all": "npm run process-budget && npm run process-revenue && npm run process-salaries && npm run process-transactions",
    "load-ev-finances": "node scripts/loadEVFinances.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@empoweredvote/analytics": "^0.1.3",
    "@empoweredvote/ev-ui": "^0.10.2",
    "@floating-ui/react": "^0.27.19",
    "@google-cloud/bigquery": "^7.9.4",
    "@napi-rs/canvas": "^0.1.100",
    "@supabase/supabase-js": "^2.100.1",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.562.0",
    "pdftoimg-js": "^0.2.5",
    "posthog-js": "^1.376.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@posthog/rollup-plugin": "^1.4.7",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
}
